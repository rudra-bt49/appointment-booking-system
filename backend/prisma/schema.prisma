generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DOCTOR
  PATIENT
}

enum AppointmentStatus {
  REQUESTED
  APPROVED
  REJECTED
  SCHEDULED
  COMPLETED
}

enum PaymentStatus {
  NOT_INITIATED
  PENDING
  SUCCESS
  FAILED
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role

  fullName  String
  phone     String?
  avatarUrl String?

  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile  DoctorProfile?
  patientProfile PatientProfile?
  refreshToken   RefreshToken?

  @@index([role])
}

model DoctorProfile {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique

  specialization String
  experience     Int
  bio            String?

  fees        Int     @default(500)
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilities  DoctorAvailability[]
  appointments    Appointment[]
  ratings         Rating[]
}

model PatientProfile {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique

  dateOfBirth DateTime?
  gender      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  ratings      Rating[]
}

model DoctorAvailability {
  id        Int      @id @default(autoincrement())
  doctorId  Int
  date      DateTime

  startDuration DateTime @db.Timestamp(0)
  endDuration   DateTime @db.Timestamp(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  timeSlots TimeSlot[]

}

model TimeSlot {
  id             Int      @id @default(autoincrement())
  availabilityId Int

  startTime DateTime @db.Timestamp(0)
  endTime   DateTime @db.Timestamp(0)

  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  availability DoctorAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
   
}

model Appointment {
  id         Int @id @default(autoincrement())
  doctorId   Int
  patientId  Int
  timeSlotId Int 

  status    AppointmentStatus @default(REQUESTED)
  notes     String?
  reportUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor   DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient  PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  timeSlot TimeSlot       @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)

  payment Payment?
  rating  Rating?
}

model Payment {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique

  amount        Int
  currency      String   @default("INR")
  status PaymentStatus @default(NOT_INITIATED)

  paymentExpiry DateTime

  stripeSessionId String?
  stripePaymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Rating {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique
  doctorId      Int
  patientId     Int

  rating Int
  review String?

  createdAt DateTime @default(now())

  appointment Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor      DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
